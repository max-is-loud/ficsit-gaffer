{
  "name": "@foreman/sf-flow",
  "version": "0.1.0",
  "description": "Pure steady-state material-flow solver: reconciles source output, sink demand, edge throughput caps, splitter filters and fluid head lift over an abstract flow network. No game data or save types; usable without the MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 && prettier --check \"{src,test}/**/*.ts\" eslint.config.js",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write \"{src,test}/**/*.ts\" eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
