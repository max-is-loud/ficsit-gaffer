{
  "name": "@foreman/sf-mcp",
  "version": "0.1.0",
  "description": "FICSIT Foreman unified MCP server: serves the Satisfactory game-data graph tools and live save-game tools from one endpoint.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "foreman-sf-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect:game-data": "tsx src/scripts/inspectGameData.ts",
    "inspect:save": "tsx src/scripts/inspectSave.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check \"{src,test}/**/*.ts\" eslint.config.js",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write \"{src,test}/**/*.ts\" eslint.config.js"
  },
  "dependencies": {
    "@foreman/sf-flow": "0.1.0",
    "@foreman/sf-game-data": "0.1.0",
    "@foreman/sf-game-data-graph": "0.1.0",
    "@foreman/sf-present": "0.1.0",
    "@foreman/sf-save-data": "0.1.0",
    "@foreman/sf-save-data-graph": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
