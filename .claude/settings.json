{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mainspring hook --provider claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mainspring hook --provider claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mainspring hook --provider claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
